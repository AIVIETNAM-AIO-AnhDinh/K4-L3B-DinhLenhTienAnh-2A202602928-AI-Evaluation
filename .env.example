# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.

# --- OpenRouter (OpenAI-compatible) ---
# The OpenAI SDK reads OPENAI_BASE_URL automatically, so no code change is needed.
# Get a key at https://openrouter.ai/keys (starts with "sk-or-").
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model IDs are prefixed with the provider, e.g. openai/gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini

# --- Direct OpenAI (alternative) ---
# Remove OPENAI_BASE_URL and use a plain model name:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
